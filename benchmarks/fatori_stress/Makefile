# FATORI Stress Benchmark Makefile
#
# This benchmark requires no special setup - all source files are
# self-contained in this directory. The main build system will
# automatically compile all .c files when BENCHMARK_DIR points here.

done:
	@echo "FATORI Stress benchmark ready!"

setup: done

clean:
	@echo "Nothing to clean (no generated files)"

.PHONY: done setup clean